    const menu = document.getElementById('sports-menu');
    const content = document.getElementById('content-area');
    const title = document.getElementById('section-title');

    // Бастапқы жүктеу
    function init() {
        sportsDB.forEach((sport, index) => {
            const card = document.createElement('div');
            card.className = `sport-card ${index === 0 ? 'active' : ''}`;
            card.innerHTML = `<i class="fas ${sport.icon}"></i> <span>${sport.name}</span>`;
            card.onclick = () => loadSport(index, card);
            menu.appendChild(card);
        });
        
        // Бірінші спортты ашу
        loadSport(0, document.querySelector('.sport-card'));
    }

    function loadSport(index, element) {
        // Активті класты ауыстыру
        document.querySelectorAll('.sport-card').forEach(el => el.classList.remove('active'));
        if(element) element.classList.add('active');

        const data = sportsDB[index];
        title.innerText = `${data.name} бойынша бапкерлер мен спортшылар`;
        content.innerHTML = '';

        if(data.coaches.length === 0) {
            content.innerHTML = '<p style="text-align:center; color:#888;">Ақпарат енгізілуде...</p>';
            return;
        }

        data.coaches.forEach((coach, cIdx) => {
            const uniqueId = `coach-${index}-${cIdx}`;
            
            // Спортшыларды HTML-ге айналдыру
            let athletesHTML = '';
            if(coach.athletes.length > 0) {
                athletesHTML = coach.athletes.map(a => `
                    <div class="athlete-item">
                        <img src="${a.photo}" class="athlete-photo">
                        <div>
                            <strong>${a.name}</strong> (${a.year} ж.т.)<br>
                            <span style="font-size:12px; color:#555">${a.award}</span>
                        </div>
                    </div>
                `).join('');
            } else {
                athletesHTML = '<p style="padding:10px; color:#777;">Тізім бос.</p>';
            }

            const html = `
                <div class="coach-card">
                    <div class="coach-main">
                        <img src="${coach.photo}" class="coach-photo" alt="Бапкер">
                        <div class="coach-details">
                            <h3>${coach.name}</h3>
                            <span class="rank">${coach.rank}</span>
                            <button class="btn-toggle" onclick="toggleDetails('${uniqueId}', this)">
                                Спортшыларды көру
                            </button>
                        </div>
                    </div>
                    <div id="${uniqueId}" class="athletes-section">
                        <h4>Шәкірттері:</h4>
                        ${athletesHTML}
                    </div>
                </div>
            `;
            content.innerHTML += html;
        });
    }

    function toggleDetails(id, btn) {
        const section = document.getElementById(id);
        section.classList.toggle('open');
        btn.innerText = section.classList.contains('open') ? "Жабу" : "Спортшыларды көру";
    }

    init();
</script>

