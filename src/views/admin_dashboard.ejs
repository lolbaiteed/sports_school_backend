<!DOCTYPE html>
<html lang="kk">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Басқару Панелі</title>
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="dashboard-body">

  <div id="admin-panel" class="panel-container">
    <header class="panel-header">
      <h2>
        <%= tAdmin("adminPanel") %>
      </h2>
      <button id="logout-btn" class="logout-btn">
        <%= tAdmin("logout")%>
      </button>
    </header>

    <div id="sports-view">
      <h3>
        <%= tAdmin("PickSport")%>:
      </h3>
      <div class="sports-grid" id="sports-grid-admin">
        <% disciplines.forEach(discipline=> {%>
          <div class="sport-item" onclick="showCoaches('<%= tDiscipline(discipline) %>', '<%= discipline %>')">
            <i class="fa-solid ${s.icon}"></i>
            <h4>
              <%= tDiscipline(discipline) %>
            </h4>
          </div>
          <%})%>
      </div>
    </div>

    <div id="coaches-view" class="hidden">
      <button id="backToSports-btn" class="back-btn">
        <%= tAdmin("backToSports")%>
      </button>
      <button onclick="addCoach()" id="addCoach" class="add-btn">
        <%= tAdmin("addCoach")%>
      </button>
      <h3 id="selected-sport-title"></h3>
      <div class="list-group" id="coaches-list-admin">
      </div>
    </div>

    <div id="manager-view" class="hidden">
      <button onclick="goBackToCoaches()" id="backToCoach-btn" class="back-btn">
        <%= tAdmin('GoBack')%>
      </button>
      <h3 id="manager-coach-name" style="color: var(--primary); margin: 15px 0;">Бапкер аты</h3>

      <div class="admin-actions-grid">
        <div class="admin-card">
          <h4>📅 <%= tAdmin('EventSelector')%>
          </h4>
          <form id="eventForm" action="/api/Event/add" method="post" enctype='multipart/form-data' class="form-group">
            <select id="event-type" name="eventType">
              <option>
                <%= tAdmin('EventType1')%>
              </option>
              <option>
                <%= tAdmin('EventType2')%>
              </option>
            </select>
            <input type="text" id="event-name" name="eventName" placeholder="<%= tAdmin('EventName')%>">
            <input type="text" id="event-loc" name="coordsUrl" placeholder="<%= tAdmin('EventPlace')%>">
            <label for="startDate">Start Date</label>
            <input type="date" name="startDate" placeholder="Start Date">
            <label for="endDate">End Date</label>
            <input type="date" name="endDate">
            <label>
              <%= tAdmin('EventRules')%><input type="file" id="event-pdf">
            </label>
            <label>
              <%= tAdmin('Protocol')%><input type="file" id="event-pdf">
            </label>
            <input type="number" name="CoachId" value="" hidden>
            <button type="submit" class="cta-btn">
              <%= tAdmin('AddEvent')%>
            </button>
          </form>
        </div>

        <div class="admin-card">
          <h4>➕ <%= tAdmin('AddStudent')%>
          </h4>
          <form action="/api/student/add" method="post" enctype="multipart/form-data" id='studentForm' class="form-group">
            <input type="text" name="firstName" required placeholder="<%= tAdmin('studentFirstName') %>">
            <input type="text" name="lastName" required placeholder="<%= tAdmin('studentLastName')%>">
            <input type="text" name="middleName" required placeholder="<%= tAdmin('studentMiddleName')%>">
            <input type="number" id="CoachId" name="coachId" hidden>
            <input type="text" id="Discipline" name="discipline" hidden>
            <input type="number" name="eventId" hidden> 
            <input type="tel" pattern="[0-9]{3}[0-9]{3}[0-9]{4}" required name="phoneNumber"
              placeholder="<%= tAdmin('studentPhoneNumber')%>">
            <input type="date" name="dateOfBirth" required id="new-ath-dob">
            <input type="file" name="avatar" required id="new-ath-photo" accept="image/*">
            <button type="submit" class="cta-btn" style="background:green; color:white;">
              <%= tAdmin('Add')%>
            </button>
          </form>
        </div>
      </div>

      <div class="admin-card full-width" style="margin-top:20px;">
        <h4>
          <%= tAdmin('StudentList')%>
        </h4>
        <div id="coach-athletes-table" class="attendance-list">
        </div>
        <button id="exel-btn" class="excel-btn"><i class="fa-solid fa-file-excel"></i> Excel жүктеу</button>
      </div>
    </div>
  </div>

  <script>
    window.coachesData = <%- JSON.stringify(coaches) %>;
    window.studentsData = <%- JSON.stringify(students) %>;
    const langDataArr = [
      '<%= tAdmin('chsEmpty') %>',
      '<%= tAdmin('chs')%>',
      '<%= tAdmin('control')%>',
    ];

    window.langData = langDataArr; 
  </script>
  <script src="js/admin_dash.js"></script>
</body>

</html>
